        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M46.5,53 c0,4.1 3.4,7.5 7.5,7.5 s7.5,-3.4 7.5,-7.5" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,60.5 v4.5 M50,65 h8" />

    <!-- Audio pulse indicators -->
    <path
        android:strokeColor="#80D8FF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M27,54 C27,51 27.5,48 28.5,45 M81,54 C81,51 80.5,48 79.5,45" />
