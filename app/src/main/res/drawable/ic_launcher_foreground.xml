        android:strokeWidth="1.2"
        android:fillColor="#00000000"
        android:pathData="M54,32 A22,22 0 1,1 53.9,32" />

    <!-- Center circular core with gradient -->
    <path
        android:pathData="M54,36 A18,18 0 1,1 53.9,36">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="40"
                android:endX="68"
                android:endY="68"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="1.0" android:color="#2979FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center microphone glyph in crisp white -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,44 c2.2,0 4,1.8 4,4 v8 c0,2.2 -1.8,4 -4,4 s-4,-1.8 -4,-4 v-8 c0,-2.2 1.8,-4 4,-4 z" />
